{
  "name": "campus-recall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:fast && npm run test:browser && npm run test:acceptance",
    "test:fast": "vitest run",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint src tests && node scripts/check-product.mjs && node scripts/check-spec-coverage.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:browser": "playwright test tests/e2e",
    "test:acceptance": "playwright test tests/acceptance",
    "preview": "vite preview --host 127.0.0.1",
    "qa:prepare": "node scripts/prepare-qa-kit.mjs",
    "qa:https": "node scripts/qa-https.mjs",
    "qa:webpages": "node scripts/qa-webpages.mjs",
    "qa:device:prepare": "node scripts/device-session.mjs prepare",
    "qa:device:serve": "node scripts/device-session.mjs serve",
    "models:download": "node scripts/download-assets.mjs",
    "format:check": "prettier --check src/ui src/app src/engine src/shared/browser-assets.ts src/main.tsx scripts tests/app tests/acceptance tests/e2e tests/engine tests/storage/integration.test.ts tests/spec tests/tooling vite.config.ts playwright.config.ts playwright.webkit.config.ts eslint.config.js src/sw.ts",
    "premodels:download": "node scripts/prepare-assets.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:webkit": "playwright test --config playwright.webkit.config.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@huggingface/transformers": "4.3.1",
    "dexie": "4.2.1",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  }
}

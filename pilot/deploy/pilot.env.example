# Non-secret settings only. Copy to /opt/campus-recall/.env (mode 0600).
PILOT_IMAGE=campus-recall-pilot:RELEASE_ID
PILOT_DOMAIN=recall.example.org
PILOT_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
PILOT_BLOB_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net
PILOT_SECRETS_DIR=/etc/campus-recall/secrets
PILOT_DATA_DIR=/srv/campus-recall
PILOT_DATABASE_SCHEMA=pilot
# Set these to the resolved digest used for the reviewed release.
PILOT_POSTGRES_IMAGE=postgres:17.11-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac
PILOT_CADDY_IMAGE=caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
# Leave blank for the VM's system-assigned identity.
PILOT_MANAGED_IDENTITY_CLIENT_ID=
# WhatsApp channel: used only with compose.whatsapp.yaml installed next to compose.yaml.
# Its three secrets are files in PILOT_SECRETS_DIR: whatsapp_verify_token, whatsapp_app_secret
# and whatsapp_access_token. Leave the Graph version and notice version blank for the defaults.
PILOT_WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
PILOT_WHATSAPP_PRIVACY_URL=https://github.com/rajmodi8905/cs437-Last_3_Brain_Cells-hack/blob/main/docs/pilot/whatsapp-privacy.md
PILOT_WHATSAPP_CONTACT_EMAIL=YOUR_CONTACT@iitgn.ac.in
PILOT_WHATSAPP_GRAPH_VERSION=
PILOT_WHATSAPP_NOTICE_VERSION=
# Telegram channel: used only with compose.telegram.yaml installed next to compose.yaml.
# Its two secrets are files in PILOT_SECRETS_DIR: telegram_bot_token and telegram_webhook_secret.
# PILOT_TELEGRAM_ALLOWED_USERS limits the bot to these numeric user IDs or @usernames (comma
# separated) for the demo; leave it blank to let anyone use it. Leave the notice version blank
# for the default.
PILOT_TELEGRAM_PRIVACY_URL=https://github.com/rajmodi8905/cs437-Last_3_Brain_Cells-hack/blob/main/docs/pilot/telegram-privacy.md
PILOT_TELEGRAM_CONTACT_EMAIL=YOUR_CONTACT@iitgn.ac.in
PILOT_TELEGRAM_ALLOWED_USERS=
PILOT_TELEGRAM_NOTICE_VERSION=

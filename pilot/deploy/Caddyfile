{
	# Proxy errors can include OAuth callback query strings. Keep these out of logs.
	log default {
		exclude http.log.error
	}
}

{$PILOT_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		# Defaults: a response that sets its own policy keeps it (`?`). The bot link pages
		# (WhatsApp, Telegram) need `same-origin`, because with `no-referrer` browsers send
		# `Origin: null` on their form POST, and their own CSP allows their one inline style;
		# originals keep their sandbox.
		?Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		# Defence in depth: the app parses untrusted PDFs, webpages and media. Scripts, workers
		# and WASM come only from this origin (the ONNX runtime imports its loader through a
		# blob: URL). Setup downloads model files from Hugging Face and the OCR language file
		# from jsDelivr. Nothing may frame the app. Checked behind Caddy with real setup, OCR,
		# PDF extraction and search on 10 November 2026.
		# connect-src allows any HTTPS origin: Add > Webpage fetches the student's chosen public
		# page directly from the browser (SPEC S4; no cookies sent, and the page's own CORS
		# decides). This covers Hugging Face and jsDelivr too. Scripts stay same-origin only.
		# tests/e2e/production-csp.spec.ts applies this exact policy to the app.
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' https:; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# No HTTP access log: document IDs, OAuth codes and query strings are private.
	reverse_proxy app:4600 {
		# Overwrite any client-supplied forwarding chain at our only public proxy.
		header_up X-Forwarded-For {remote_host}
	}
}
